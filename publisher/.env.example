# Copy this file to publisher/.env and fill it in. Never commit .env.

# Where you open the app. Must match the redirect URLs you register with each platform:
#   <PUBLIC_BASE_URL>/auth/youtube/callback
#   <PUBLIC_BASE_URL>/auth/meta/callback
#   <PUBLIC_BASE_URL>/auth/tiktok/callback
PUBLIC_BASE_URL=http://localhost:8000
PORT=8000

# Required whenever PUBLIC_BASE_URL is not localhost (for example an https tunnel for TikTok).
APP_PASSWORD=

# Set to 1 to try the app without uploading anything.
PUBLISHER_DRY_RUN=0

# YouTube: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook + Instagram: developers.facebook.com > your app > App settings > Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# TikTok: developers.tiktok.com > your app > App details
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
